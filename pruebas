    <script>
        const NUMERO_WHATSAPP = "5493425688013";
        const HORARIOS_DISPONIBLES = ["09:00", "11:00", "15:00", "17:00"];
        const INTERVALO_SERVICE_KM = 2000;
        const INTERVALO_SERVICE_MESES = 6;
        const CLAVE_TALLER = "masracing2026";

        let servicioSeleccionado = null;
        let clientesBD = JSON.parse(localStorage.getItem('masracing_clientes')) || {};
        let turnosBD = JSON.parse(localStorage.getItem('masracing_turnos')) || [];

        function formatearFecha(fechaISO) {
            const [y, m, d] = fechaISO.split('-');
            return `${d}/${m}/${y}`;
        }

        function calcularProximoService(historial) {
            const conKm = (historial || []).filter(h => h.km);
            if (conKm.length === 0) return null;

            const ultimo = conKm[conKm.length - 1];
            const proximoKm = parseInt(ultimo.km) + INTERVALO_SERVICE_KM;

            const fechaUltimo = new Date(ultimo.fecha + 'T00:00:00');
            const fechaProxima = new Date(fechaUltimo);
            fechaProxima.setMonth(fechaProxima.getMonth() + INTERVALO_SERVICE_MESES);

            const vencidoPorFecha = new Date() >= fechaProxima;

            return {
                ultimo: ultimo,
                proximoKm: proximoKm,
                fechaProximaISO: fechaProxima.toISOString().split('T')[0],
                vencidoPorFecha: vencidoPorFecha
            };
        }

        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            if (tabId === 'tab-perfil' && sessionStorage.getItem('taller_autenticado') === 'true') {
                document.getElementById('tallerLogin').classList.add('hidden');
                document.getElementById('tallerPanel').classList.remove('hidden');
                if (!document.getElementById('tallerFecha').value) {
                    document.getElementById('tallerFecha').value = new Date().toISOString().split('T')[0];
                }
            }
        }

        function seleccionarServicio(card, servicio) {
            document.querySelectorAll('.service-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');
            servicioSeleccionado = servicio;

            const texto = document.getElementById('servicioSeleccionadoTexto');
            texto.innerHTML = `<i class="fa-solid fa-check-circle text-success"></i> <strong>${servicio}</strong>`;
            texto.style.color = "var(--text-primary)";

            document.getElementById('turnos').scrollIntoView({ behavior: 'smooth' });
        }

        function registrarCliente() {
            const dni = document.getElementById('regDni').value.trim();
            const nombre = document.getElementById('regNombre').value.trim();
            const telefono = document.getElementById('regTelefono').value.trim();
            const email = document.getElementById('regEmail').value.trim();

            if (!dni || !nombre || !telefono || !email) {
                alert("Por favor completá todos los campos para registrarte.");
                return;
            }

            clientesBD[dni] = {
                nombre: nombre,
                telefono: telefono,
                email: email,
                trabajosRealizados: clientesBD[dni] ? clientesBD[dni].trabajosRealizados : 0,
                historialServicios: clientesBD[dni] ? (clientesBD[dni].historialServicios || []) : []
            };

            localStorage.setItem('masracing_clientes', JSON.stringify(clientesBD));
            alert("¡Registro exitoso! Ya podés solicitar tus turnos.");
            
            document.getElementById('turnoDni').value = dni;
            verificarDniAuto();
            
            const tabTurno = document.querySelector('.tab-btn:nth-child(2)');
            switchTab('tab-turno', tabTurno);
        }

        function verificarDniAuto() {
            const dni = document.getElementById('turnoDni').value.trim();
            const badge = document.getElementById('clienteBox');

            if (clientesBD[dni]) {
                const cliente = clientesBD[dni];
                document.getElementById('badgeNombre').innerText = cliente.nombre;
                document.getElementById('badgeDni').innerText = dni;
                document.getElementById('badgeTrabajos').innerText = cliente.trabajosRealizados;
                
                const descuentoEl = document.getElementById('badgeDescuento');
                if (cliente.trabajosRealizados >= 3) {
                    descuentoEl.classList.remove('hidden');
                } else {
                    descuentoEl.classList.add('hidden');
                }

                const historial = cliente.historialServicios || [];
                const cajaHistorial = document.getElementById('badgeHistorial');
                if (historial.length > 0) {
                    cajaHistorial.innerHTML = "<strong>Últimos servicios:</strong><br>" +
                        historial.slice(-3).reverse()
                            .map(h => `• ${h.servicio} — ${h.fecha}`)
                            .join("<br>");
                } else {
                    cajaHistorial.innerHTML = "Todavía no tiene servicios registrados.";
                }

                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function actualizarHorariosDisponibles() {
            const fecha = document.getElementById('turnoFecha').value;
            const selectHora = document.getElementById('turnoHora');
            selectHora.innerHTML = "";

            if (!fecha) return;

            const ocupados = turnosBD
                .filter(t => t.fecha === fecha && t.estado === "AGENDADO")
                .map(t => t.hora);

            HORARIOS_DISPONIBLES.forEach(hora => {
                const option = document.createElement("option");
                option.value = hora;
                if (ocupados.includes(hora)) {
                    option.text = `${hora}hs - NO DISPONIBLE`;
                    option.disabled = true;
                } else {
                    option.text = `${hora}hs`;
                }
                selectHora.appendChild(option);
            });
        }

        function reservarYEnviarWhatsApp() {
            const dni = document.getElementById('turnoDni').value.trim();
            const fecha = document.getElementById('turnoFecha').value;
            const hora = document.getElementById('turnoHora').value;
            const marca = document.getElementById('motoMarca').value;
            const modelo = document.getElementById('motoModelo').value || "No especificado";
            const km = document.getElementById('motoKm').value.trim();
            const repuestos = document.getElementById('repuestosModo').value;

            if (!servicioSeleccionado) {
                alert("Primero seleccioná un servicio de la sección 'Servicios Disponibles'.");
                document.getElementById('servicios').scrollIntoView({ behavior: 'smooth' });
                return;
            }

            if (!dni) {
                alert("Por favor ingresá tu DNI.");
                return;
            }

            if (!clientesBD[dni]) {
                alert("Este DNI no está registrado. Registrate primero.");
                const tabRegistro = document.querySelector('.tab-btn:nth-child(1)');
                switchTab('tab-registro', tabRegistro);
                document.getElementById('regDni').value = dni;
                return;
            }

            if (!fecha || !hora) {
                alert("Elegí una fecha y horario.");
                return;
            }

            const nuevoTurno = {
                id: Date.now(),
                dni: dni,
                clienteNombre: clientesBD[dni].nombre,
                fecha: fecha,
                hora: hora,
                marca: marca,
                modelo: modelo,
                servicio: servicioSeleccionado,
                repuestos: repuestos,
                estado: "AGENDADO"
            };

            turnosBD.push(nuevoTurno);
            
            if (!clientesBD[dni].historialServicios) {
                clientesBD[dni].historialServicios = [];
            }
            clientesBD[dni].historialServicios.push({
                fecha: fecha,
                hora: hora,
                servicio: servicioSeleccionado,
                moto: `${marca} ${modelo}`,
                km: km || null
            });
            clientesBD[dni].trabajosRealizados += 1;

            localStorage.setItem('masracing_turnos', JSON.stringify(turnosBD));
            localStorage.setItem('masracing_clientes', JSON.stringify(clientesBD));

            const mensaje = `Hola *MAS RACING*! Confirmación de Turno:%0A%0A` +
                            `👤 *Cliente:* ${clientesBD[dni].nombre} (DNI: ${dni})%0A` +
                            `🏍️ *Moto:* ${marca} ${modelo}${km ? ' (' + km + ' km)' : ''}%0A` +
                            `🛠️ *Servicio:* ${servicioSeleccionado}%0A` +
                            `📦 *Repuestos:* ${repuestos}%0A` +
                            `📅 *Fecha:* ${fecha}%0A` +
                            `⏰ *Hora:* ${hora}hs%0A%0A` +
                            `¡Nos vemos!`;

            alert("¡Turno reservado exitosamente!");
            actualizarHorariosDisponibles();
            verificarDniAuto();
            window.open(`https://wa.me/${NUMERO_WHATSAPP}?text=${mensaje}`, '_blank');

            servicioSeleccionado = null;
            document.querySelectorAll('.service-card').forEach(c => c.classList.remove('selected'));
            const texto = document.getElementById('servicioSeleccionadoTexto');
            texto.innerText = "Ninguno todavía — elegí uno en 'Servicios Disponibles' ⬇️";
            texto.style.color = "var(--text-tertiary)";
        }

        function buscarTurnosCliente() {
            const dni = document.getElementById('buscarDni').value.trim();
            const contenedor = document.getElementById('listaMisTurnos');
            contenedor.innerHTML = "";

            if (!dni) {
                alert("Ingresá tu DNI.");
                return;
            }

            const misTurnos = turnosBD.filter(t => t.dni === dni && t.estado === "AGENDADO");

            if (misTurnos.length === 0) {
                contenedor.innerHTML = `
                    <div class="historial-empty">
                        <i class="fa-regular fa-calendar-xmark"></i>
                        <p>No tenés turnos vigentes agendados</p>
                    </div>`;
                return;
            }

            misTurnos.forEach(t => {
                const item = document.createElement('div');
                item.className = 'turno-item';
                item.innerHTML = `
                    <div class="turno-info">
                        <h4>${t.servicio}</h4>
                        <p>${t.fecha} a las ${t.hora}hs · ${t.marca} ${t.modelo}</p>
                    </div>
                    <button class="btn btn-danger" onclick="cancelarTurno(${t.id})">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                `;
                contenedor.appendChild(item);
            });
        }

        function cancelarTurno(turnoId) {
            if (confirm("¿Cancelar este turno?")) {
                turnosBD = turnosBD.map(t => {
                    if (t.id === turnoId) t.estado = "CANCELADO";
                    return t;
                });

                localStorage.setItem('masracing_turnos', JSON.stringify(turnosBD));
                alert("Turno cancelado.");
                buscarTurnosCliente();
                actualizarHorariosDisponibles();
            }
        }

        function ingresarPanelTaller() {
            const clave = document.getElementById('tallerClave').value;
            if (clave === CLAVE_TALLER) {
                sessionStorage.setItem('taller_autenticado', 'true');
                document.getElementById('tallerLogin').classList.add('hidden');
                document.getElementById('tallerPanel').classList.remove('hidden');
                document.getElementById('tallerFecha').value = new Date().toISOString().split('T')[0];
            } else {
                alert('Clave incorrecta.');
            }
        }

        function buscarClienteTaller() {
            const dni = document.getElementById('tallerDni').value.trim();
            const infoBox = document.getElementById('tallerClienteInfo');
            const nuevoBox = document.getElementById('tallerNombreNuevoBox');

            if (!dni) return;

            if (clientesBD[dni]) {
                document.getElementById('tallerClienteNombre').innerText = clientesBD[dni].nombre;
                document.getElementById('tallerClienteTrabajos').innerText = clientesBD[dni].trabajosRealizados;
                infoBox.classList.remove('hidden');
                nuevoBox.classList.add('hidden');
            } else {
                infoBox.classList.add('hidden');
                nuevoBox.classList.remove('hidden');
            }

            renderHistorialTaller(dni);
        }

        function guardarTrabajoTaller() {
            const dni = document.getElementById('tallerDni').value.trim();
            const fecha = document.getElementById('tallerFecha').value;
            const km = document.getElementById('tallerKm').value.trim();
            const marca = document.getElementById('tallerMarca').value.trim();
            const modelo = document.getElementById('tallerModelo').value.trim();
            const servicio = document.getElementById('tallerServicio').value;
            const notas = document.getElementById('tallerNotas').value.trim();

            if (!dni || !fecha || !marca || !modelo) {
                alert('Completá DNI, fecha, marca y modelo.');
                return;
            }

            if (!clientesBD[dni]) {
                const nombreNuevo = document.getElementById('tallerNombreNuevo').value.trim();
                if (!nombreNuevo) {
                    alert('Cliente nuevo: cargá el nombre.');
                    return;
                }
                clientesBD[dni] = {
                    nombre: nombreNuevo,
                    telefono: '',
                    email: '',
                    trabajosRealizados: 0,
                    historialServicios: []
                };
            }

            if (!clientesBD[dni].historialServicios) {
                clientesBD[dni].historialServicios = [];
            }

            clientesBD[dni].historialServicios.push({
                fecha: fecha,
                hora: '',
                servicio: servicio + (notas ? ' — ' + notas : ''),
                moto: `${marca} ${modelo}`,
                km: km || null
            });
            clientesBD[dni].trabajosRealizados += 1;

            localStorage.setItem('masracing_clientes', JSON.stringify(clientesBD));

            alert('Trabajo guardado.');

            document.getElementById('tallerKm').value = '';
            document.getElementById('tallerNotas').value = '';
            buscarClienteTaller();
        }

        function renderHistorialTaller(dni) {
            const contenedor = document.getElementById('tallerHistorial');
            contenedor.innerHTML = '';

            if (!clientesBD[dni]) {
                contenedor.innerHTML = '<p style="color: var(--text-tertiary); font-size: 13px;">Cliente nuevo.</p>';
                return;
            }

            const historial = (clientesBD[dni].historialServicios || []).slice();

            const info = calcularProximoService(historial);
            if (info) {
                contenedor.innerHTML += `
                    <div class="info-box" style="border-color: ${info.vencidoPorFecha ? 'var(--accent-primary)' : 'var(--success)'};">
                        <div class="info-box-title">Próximo Service Sugerido</div>
                        <div class="info-box-content">
                            <strong style="color: ${info.vencidoPorFecha ? 'var(--accent-primary)' : 'var(--success)'};">
                                Antes de ${info.proximoKm.toLocaleString('es-AR')} km o ${formatearFecha(info.fechaProximaISO)}
                            </strong>
                            ${info.vencidoPorFecha ? '<div style="margin-top: 8px; color: var(--accent-primary); font-weight: 600;">⚠️ Tiempo recomendado superado</div>' : ''}
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary btn-block mb-4" onclick="enviarRecordatorioWhatsApp('${dni}')">
                        <i class="fa-brands fa-whatsapp"></i> Enviar Recordatorio por WhatsApp
                    </button>
                `;
            }

            if (historial.length === 0) {
                contenedor.innerHTML += '<p style="color: var(--text-tertiary); font-size: 13px;">Sin trabajos registrados.</p>';
                return;
            }

            let html = `<div class="turnos-list">`;
            historial.map((h, i) => ({ ...h, _idx: i })).reverse().forEach(h => {
                html += `
                    <div class="turno-item">
                        <div class="turno-info">
                            <h4>${h.fecha}</h4>
                            <p>${h.servicio} · ${h.moto}${h.km ? ' · ' + parseInt(h.km).toLocaleString('es-AR') + ' km' : ''}</p>
                        </div>
                        <button class="btn btn-danger" onclick="eliminarTrabajoTaller('${dni}', ${h._idx})">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
            });
            html += `</div>`;
            contenedor.innerHTML += html;
        }

        function eliminarTrabajoTaller(dni, idx) {
            if (!confirm('¿Eliminar este trabajo?')) return;
            if (!clientesBD[dni] || !clientesBD[dni].historialServicios) return;

            clientesBD[dni].historialServicios.splice(idx, 1);
            if (clientesBD[dni].trabajosRealizados > 0) {
                clientesBD[dni].trabajosRealizados -= 1;
            }

            localStorage.setItem('masracing_clientes', JSON.stringify(clientesBD));
            buscarClienteTaller();
        }

        function normalizarTelefonoAR(tel) {
            let limpio = (tel || '').replace(/[^0-9]/g, '');
            if (limpio.startsWith('54')) return limpio;
            if (limpio.length === 10) return '549' + limpio;
            return limpio;
        }

        function enviarRecordatorioWhatsApp(dni) {
            const cliente = clientesBD[dni];
            if (!cliente) return;

            if (!cliente.telefono) {
                alert('Cliente sin teléfono cargado.');
                return;
            }

            const historial = cliente.historialServicios || [];
            const info = calcularProximoService(historial);
            if (!info) {
                alert('Sin kilometraje registrado.');
                return;
            }

            const telWa = normalizarTelefonoAR(cliente.telefono);
            const mensaje = `Hola ${cliente.nombre}! Te escribimos de *MAS RACING* 🏍️%0A%0A` +
                            `Último trabajo (${info.ultimo.servicio}): ${formatearFecha(info.ultimo.fecha)} con ${parseInt(info.ultimo.km).toLocaleString('es-AR')} km.%0A%0A` +
                            `Próximo service: antes de ${info.proximoKm.toLocaleString('es-AR')} km o ${formatearFecha(info.fechaProximaISO)}.%0A%0A` +
                            `¿Coordinamos un turno? 🛠️`;

            window.open(`https://wa.me/${telWa}?text=${mensaje}`, '_blank');
        }

        function verMiPerfilCliente() {
            const dni = document.getElementById('clienteMiPerfilDni').value.trim();
            const contenedor = document.getElementById('clienteMiPerfilResultado');
            contenedor.innerHTML = '';

            if (!dni) {
                alert('Ingresá tu DNI.');
                return;
            }

            if (!clientesBD[dni]) {
                contenedor.innerHTML = `
                    <div class="info-box">
                        <div class="info-box-title">Cliente no encontrado</div>
                        <div class="info-box-content">Registrate primero en la pestaña 'Registro'.</div>
                    </div>`;
                return;
            }

            const cliente = clientesBD[dni];
            const historial = (cliente.historialServicios || []).slice();

            let html = `
                <div class="info-box">
                    <div class="info-box-title">${cliente.nombre}</div>
                    <div class="info-box-content">
                        DNI: ${dni} · Trabajos: ${cliente.trabajosRealizados}
                        ${cliente.trabajosRealizados >= 3 ? '<span class="badge badge-success" style="margin-left: 8px;"><i class="fa-solid fa-tag"></i> 10% Descuento</span>' : ''}
                    </div>
                </div>
            `;

            const info = calcularProximoService(historial);
            if (info) {
                html += `
                    <div class="info-box" style="border-color: ${info.vencidoPorFecha ? 'var(--accent-primary)' : 'var(--success)'};">
                        <div class="info-box-title">Próximo Service Recomendado</div>
                        <div class="info-box-content">
                            <strong style="color: ${info.vencidoPorFecha ? 'var(--accent-primary)' : 'var(--success)'};">
                                Antes de ${info.proximoKm.toLocaleString('es-AR')} km o ${formatearFecha(info.fechaProximaISO)}
                            </strong>
                            ${info.vencidoPorFecha ? '<div style="margin-top: 8px; color: var(--accent-primary);">⚠️ Tiempo superado. ¡Pedí tu turno!</div>' : ''}
                        </div>
                    </div>
                `;
            }

            html += `<div style="margin-top: 20px; font-size: 13px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">Historial de Trabajos</div>`;

            if (historial.length === 0) {
                html += `<p style="color: var(--text-tertiary); font-size: 14px;">Sin trabajos registrados.</p>`;
            } else {
                html += `<div class="turnos-list">`;
                historial.slice().reverse().forEach(h => {
                    html += `
                        <div class="turno-item">
                            <div class="turno-info">
                                <h4>${h.servicio}</h4>
                                <p>${h.fecha} · ${h.moto}${h.km ? ' · ' + parseInt(h.km).toLocaleString('es-AR') + ' km' : ''}</p>
                            </div>
                        </div>
                    `;
                });
                html += `</div>`;
            }

            contenedor.innerHTML = html;
        }

        document.getElementById('turnoFecha').min = new Date().toISOString().split("T")[0];
    </script>
</body>
</html>
